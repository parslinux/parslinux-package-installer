[Desktop Entry]
Name=Pars Linux Package Installer
Name[pt]=Instalador de Pacotes Pars Linux
Name[tr]=Pars Linux Paket Kurucu
GenericName=Package Installer
GenericName[pt]=Instalador de Pacotes
GenericName[tr]=Paket Kurucu
Comment=Install, view and manage Debian (.deb) and Arch Linux (.pkg.tar.*) packages
Comment[pt]=Instalar, ver e gerenciar pacotes Debian (.deb) e Arch Linux (.pkg.tar.*)
Comment[tr]=Debian (.deb) ve Arch Linux (.pkg.tar.*) yazılım paketlerini kur, incele ve yönet
Exec=parslinux-package-installer %F
Icon=parslinux-package-installer
Terminal=false
Type=Application
Categories=System;Settings;PackageManager;GTK;
MimeType=application/vnd.debian.binary-package;application/x-deb;application/x-debian-package;application/x-zstd-compressed-tar;application/x-tar;application/x-arch-package;application/x-rpm;application/x-redhat-package-manager;application/vnd.appimage;application/x-iso9660-appimage;application/vnd.flatpak.ref;application/vnd.flatpak.repo;
StartupNotify=true
StartupWMClass=org.parslinux.package-installer
Keywords=package;apt;dpkg;pacman;arch;install;deb;kurucu;paket;gdebi;toplu;
X-ParsLinux-Apps=true
Actions=Adw;

[Desktop Action Adw]
Name=Open in Modern Libadwaita Mode (GTK4)
Name[tr]=Modern Libadwaita Modunda Aç (GTK4)
Name[pt]=Abrir no Modo Libadwaita Moderno (GTK4)
Exec=parslinux-package-installer-adw %F
