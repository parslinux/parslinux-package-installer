#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import os
import sys

# Priority 1: System installation path
# Priority 2: Local source directory for development
sys_path = '/usr/share/parslinux/parslinux-package-installer/src/'
local_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'src')

if os.path.exists(sys_path):
    sys.path.insert(0, sys_path)
elif os.path.exists(local_path):
    sys.path.insert(0, local_path)

prog_name = os.path.basename(sys.argv[0])
use_adw = prog_name.endswith('-adw') or '--adw' in sys.argv or '--gtk4' in sys.argv

if '--adw' in sys.argv:
    sys.argv.remove('--adw')
if '--gtk4' in sys.argv:
    sys.argv.remove('--gtk4')

if use_adw:
    import MainAdw
    sys.exit(MainAdw.main())
else:
    import Main
    app = Main.Application()
    sys.exit(app.run(sys.argv))
